{
  "name": "learning-hub-server",
  "private": true,
  "type": "module",
  "description": "러닝허브 클라우드 백엔드(Cloudflare Workers + D1). web/ 과 분리된 별도 패키지 — 근거는 web/docs/cloudflare-런북.md §4-1.",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply learning-hub --local",
    "migrate:remote": "wrangler d1 migrations apply learning-hub --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "format:check": "prettier --check \"*.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"*.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:roundtrip": "vitest run --config vitest.roundtrip.config.ts",
    "verify": "npm run typecheck && npm run format:check && npm run test && npm run test:roundtrip"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260714.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.28.0"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260714.1": true
  }
}
