{
  // knip — 죽은 코드/의존성 게이트(0단계-F). `npm run knip`, verify에 포함.
  // 규약: 여기 예외를 늘릴 땐 **왜 오탐인지**를 주석으로 남긴다(stylelint.config.js와 같은 규약).
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // main.tsx·playwright.config.ts는 knip이 자동 인식하므로 열거하지 않는다(중복 패턴 경고).
  // e2e/test/scripts는 러너가 부르는 진입점 — 여기 없으면 그들이 쓰는 파일이 전부 '미사용'이 된다.
  // ⚠ knip 은 `web/` **밖(= `server/`)을 보지 못한다.** 그래서 Worker 만 쓰는 export 는 죽은
  // 코드로 오진된다(C-4 에서 `tableCols` 가 그렇게 걸렸다). `../server/**` 을 entry 에 넣어
  // 봤지만 프로젝트 루트 밖이라 무시된다.
  // → **예외로 덮지 않는다.** 대신 규칙을 둔다: **공유 계약(`lib/cloud/`)은 web 쪽에서도
  //   실제로 쓰이게 한다.** `tableCols` 가 그 사례였다 — `collectOutbox` 가 같은 slice 를
  //   인라인으로 하고 있어서, 그걸 쓰게 바꾸니 중복도 사라지고 오진도 사라졌다.
  //   web 이 안 쓰는데 서버만 쓰는 것이 생기면 그건 **`server/` 안에 있어야 한다는 신호**다.
  // ⚠ `src/phone/main.tsx` 는 명시한다(C-6). knip 은 `index.html` 의 진입점만 자동 인식하는데
  // 폰은 두 번째 HTML 엔트리(`phone.html`)로 들어오므로 그 그래프를 통째로 못 본다 →
  // 화면 5개가 전부 '미사용 파일'로 오진됐다. 워커도 같은 이유다(`new Worker(new URL(...))`).
  "entry": [
    "e2e/**/*.ts",
    "scripts/*.mjs",
    "test/**/*.{ts,tsx}",
    "src/phone/main.tsx",
    "src/lib/db/sqlite.worker.ts",
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs"],

  // lint-staged: husky/git 훅이 package.json 설정으로만 부른다(import 없음).
  // stylelint-config-standard: stylelint.config.js가 문자열로 extends 한다(import 없음).
  // ⚠ `tailwindcss` 는 **뺐다**(2026-07-31 `/감사 근본` F3). 사유가 _"knip 은 CSS 를 안 판다"_
  // 였는데 지금은 판다 — knip 자신이 `Remove from ignoreDependencies` 힌트로 그렇게 말했고,
  // 빼고 돌려 보니 통과한다. **힌트는 실패가 아니라 통과 옆에 뜨므로 게이트가 안 잡는다** →
  // 사문화된 예외가 남는 경로가 정확히 이것이다(a11y 원장의 사문화 사유와 같은 부류).
  "ignoreDependencies": ["lint-staged", "stylelint-config-standard"],

  "ignoreExportsUsedInFile": true,

  // artifacts.gen.ts는 gen-artifacts.mjs가 만드는 **생성물**이다 — 아티팩트마다 타입을 일괄
  // 방출하므로 일부가 미소비인 게 정상이고, 소유자는 codegen:check이지 knip이 아니다.
  "ignore": ["src/lib/artifacts.gen.ts"],

  "rules": {
    // 미사용 *타입* 내보내기는 끈다 — schema.ts의 20개 스키마가 같은 파일에서 `z.infer`로
    // 타입을 파생시키는 게 이 저장소의 규약이고(타입 SSOT), 런타임 비용도 0이라 신호가 아니다.
    // 파일/런타임 export/의존성 미사용은 그대로 error로 남는다(그게 knip을 넣은 이유).
    "types": "off"
  }
}
