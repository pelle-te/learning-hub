{
  "name": "learning-hub",
  "private": true,
  "version": "0.0.0",
  "description": "러닝허브 — 학습 대시보드 앱(React web/ + Tauri 셸 src-tauri/ · 백엔드는 셸의 Rust). cowork 워크스페이스의 서브모듈. 앱 코드는 web/.",
  "scripts": {
    "prepare": "husky",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "tauri:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "husky": "^9.1.7"
  }
}
